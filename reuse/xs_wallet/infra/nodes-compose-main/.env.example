# DomniWallet - Node Stack Environment
# Copy to .env and adjust as needed

# =============================================================================
# Bitcoin Core
# =============================================================================
# Options: main, test, regtest, signet
BITCOIN_NETWORK=main
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=bitcoinrpcpassword
BITCOIN_RPC_PORT=8332
BITCOIN_P2P_PORT=8333
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333
BITCOIN_PRUNE=0
BITCOIN_TXINDEX=1
BITCOIN_PARALLEL_CORE=0
BITCOIN_DBCACHE_RAM_MB=450
BITCOIN_MAX_CONNECTIONS=40

# =============================================================================
# Elements / Liquid
# =============================================================================
# Options: liquidv1, liquidtestnet, liquidregtest
ELEMENTS_NETWORK=liquidv1
ELEMENTS_RPC_USER=elementsrpc
ELEMENTS_RPC_PASSWORD=elementsrpcpassword
ELEMENTS_RPC_PORT=18884
ELEMENTS_P2P_PORT=18886
ELEMENTS_PRUNE=0
ELEMENTS_TXINDEX=1

# =============================================================================
# Tron (External by default)
# =============================================================================
# TRON_RPC_URL=https://api.trongrid.io
