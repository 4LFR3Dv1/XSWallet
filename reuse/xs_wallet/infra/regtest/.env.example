# DomniWallet - Regtest Environment
# Copy to .env and adjust as needed

# =============================================================================
# Bitcoin Core (regtest)
# =============================================================================
BITCOIN_NETWORK=regtest
BITCOIN_RPC_USER=domni
BITCOIN_RPC_PASSWORD=domni_regtest_pw
BITCOIN_RPC_PORT=18443
BITCOIN_P2P_PORT=18444
BITCOIN_TXINDEX=1
BITCOIN_PARALLEL_CORE=0
BITCOIN_DBCACHE_RAM_MB=450
BITCOIN_MAX_CONNECTIONS=40
BITCOIN_PRUNE=0
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333
BTC_RPC_WALLET=domniwallet

# =============================================================================
# Elements / Liquid (regtest)
# =============================================================================
ELEMENTS_NETWORK=liquidregtest
ELEMENTS_RPC_USER=elements
ELEMENTS_RPC_PASSWORD=elements_regtest_pw
ELEMENTS_RPC_PORT=18884
ELEMENTS_P2P_PORT=18886
ELEMENTS_TXINDEX=1
ELEMENTS_PRUNE=0

# =============================================================================
# Tron (External by default)
# =============================================================================
# TRON_RPC_URL=http://localhost:8090

# =============================================================================
# PostgreSQL (for gateway tests)
# =============================================================================
PG_USER=domni
PG_PASSWORD=domni_regtest_pw
PG_DB=domniwallet
PG_PORT=5432

# Wallet Service
WALLET_INTERNAL_TOKEN=
