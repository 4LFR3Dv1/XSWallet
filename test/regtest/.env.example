# XS Wallet - Environment Configuration
# Copy this file to .env and configure your values

# =============================================================================
# Network Selection
# =============================================================================
# Options: mainnet, testnet, regtest
BITCOIN_NETWORK=mainnet

# =============================================================================
# Bitcoin Core
# =============================================================================
BITCOIN_RPC_USER=xswallet
BITCOIN_RPC_PASSWORD=e8989h44n853j8442nuh5442
BITCOIN_RPC_PORT=8332
BITCOIN_TXINDEX=1
BITCOIN_PARALLEL_CORE=0
BITCOIN_DBCACHE_RAM_MB=450
BITCOIN_MAX_CONNECTIONS=40
BITCOIN_PRUNE=0
BITCOIN_ZMQ_BLOCK_PORT=28332
BITCOIN_ZMQ_TX_PORT=28333

# =============================================================================
# LND (Lightning Network Daemon)
# =============================================================================
LND_ALIAS=xs-wallet-node
LND_COLOR=#68F442
LND_WALLET_PASSWORD=e8989h44n853j8442nuh5442

# =============================================================================
# Elements/Liquid
# =============================================================================
# Options: liquidv1 (mainnet), liquidtestnet, liquidregtest
ELEMENTS_NETWORK=liquidv1
ELEMENTS_RPC_USER=elements
ELEMENTS_RPC_PASSWORD=e8989h44n853j8442nuh5442
ELEMENTS_TXINDEX=1
ELEMENTS_PRUNE=0

# =============================================================================
# Boltz Backend
# =============================================================================
